# ── Database (required) ──────────────────────────────────────────────
# Local PostgreSQL ≥14, or a Supabase/managed Postgres connection string.
DATABASE_URL="postgresql://oncoatlas:oncoatlas@localhost:5432/oncoatlas?schema=public"

# ── Evidence review (optional) ──────────────────────────────────────
# Enables approve/reject actions in /admin/evidence. Must be ≥16 random
# characters. Leave unset to keep the review queue read-only.
# Generate with: openssl rand -base64 32
ADMIN_REVIEW_TOKEN=""

# ── Ingestion (optional) ────────────────────────────────────────────
# Contact email sent to NCBI E-utilities and Crossref (polite-pool etiquette).
CONTACT_EMAIL=""
# NCBI API key raises the E-utilities limit from 3 to 10 requests/second.
NCBI_API_KEY=""

# ── Future: Supabase authentication (not yet wired) ─────────────────
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""   # server-only; never expose to the client
